{
  "name": "spiderroute",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/map-assets.mjs",
    "prebuild": "node scripts/map-assets.mjs",
    "dev": "next dev --hostname 0.0.0.0 --port 3210",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 3000",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "demo:create": "tsx scripts/create-demo.ts",
    "backup": "tsx scripts/backup.ts",
    "audit:public": "node scripts/audit-public.mjs"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.28.2": true,
    "sharp": true
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "@protomaps/basemaps": "^5.7.2",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "^0.45.0",
    "fast-xml-parser": "^5.3.0",
    "jose": "^6.1.0",
    "lucide-react": "^0.577.0",
    "maplibre-gl": "6.9.0",
    "next": "16.3.5",
    "next-auth": "4.24.15",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "^3.9.6",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0"
  }
}
